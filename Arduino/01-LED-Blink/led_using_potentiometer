const int ledPin = 9;       // LED connected to digital pin 9 (PWM)
const int potPin = A0;      // Potentiometer wiper connected to analog pin A0
int potValue = 0;           // Variable to store the raw value from the potentiometer
int brightness = 0;         // Variable to store the converted PWM value

void setup() {
  pinMode(ledPin, OUTPUT);    // Set the LED pin as an output
  pinMode(potPin, INPUT);     // Set the potentiometer pin as an input
}

void loop() {
  // Read the analog value from the potentiometer (range: 0 to 1023)
  potValue = analogRead(potPin); 
  
  // Map the 0-1023 range to 0-255 (the PWM range for analogWrite)
  brightness = map(potValue, 0, 1023, 0, 255); 
  
  // Apply the brightness value to the LED
  analogWrite(ledPin, brightness); 
}
